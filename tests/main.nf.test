nextflow_process {

    name "Test Process RUN_NGS2COUNTS"
    script "main.nf"
    process "RUN_NGS2COUNTS"

    test("Run ngs2counts on an undemultiplexed runfolder.") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = "${projectDir}/tests/test_resources/runfolder")
                input[1] = "${projectDir}/tests/test_resources/ngs2counts-mock)"
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
