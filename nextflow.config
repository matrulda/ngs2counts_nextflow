profiles {
  uppmax {
      process {
          shell = ['/bin/bash', '-euo', 'pipefail']
          executor = 'slurm'
          clusterOptions = { "-A $params.project" }
          cpus = 8
          memory = '32G'
          time = '5h'
      }
  }
  test {
    params {
      input_folder = "${baseDir}/tests/test_resources/runfolder"
      ngs2counts_executable = "${baseDir}/tests/test_resources/ngs2counts-mock"
    }
  }
}
